		"@types/crypto-js": "^4.2.2",
		"autoprefixer": "^10.5.0",
		"postcss": "^8.5.14",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^3.4.13",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	},
	"dependencies": {
		"axios": "^1.16.1",
		"crypto-js": "^4.2.0",
		"libphonenumber-js": "^1.13.6"
	}
